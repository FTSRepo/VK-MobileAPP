{
  "expo": {
    "name": "Vklub Reward Application",
    "slug": "vklubreward",
    "scheme": "vklub",
    "version": "3.1.0",
    "orientation": "portrait",
    "icon": "./assets/applogo.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share homeworks."
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "useCleartextTraffic": true,
            "targetSdkVersion": 35
          }
        }
      ],
      "expo-font"
    ],
    "newArchEnabled": false,
    "androidStatusBar": {
      "backgroundColor": "#ef4444",
      "translucent": true
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#f87171"
    },
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/5d7df5c8-d467-479b-9ea6-eacea9f39903"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aseshar.friensys",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow app to access your photos.",
        "NSPhotoLibraryAddUsageDescription": "Allow app to save photos."
      },
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "package": "com.reward.com",
      "versionCode": 30,
      "runtimeVersion": "3.1.0",
      "edgeToEdgeEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "5d7df5c8-d467-479b-9ea6-eacea9f39903"
      }
    }
  }
}
